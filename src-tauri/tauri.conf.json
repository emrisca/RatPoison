{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RatPoison",
  "version": "0.1.5",
  "identifier": "io.github.emrisca.RatPoison",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "overlay",
        "title": "RatPoison Overlay",
        "url": "index.html?view=overlay",
        "width": 1920,
        "height": 1080,
        "x": 0,
        "y": 0,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false,
        "visible": false,
        "acceptFirstMouse": false,
        "contentProtected": false
      },
      {
        "label": "settings",
        "title": "RatPoison Settings",
        "url": "index.html?view=settings",
        "width": 1000,
        "height": 680,
        "minWidth": 780,
        "minHeight": 540,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    },
    "trayIcon": {
      "id": "ratpoison-tray",
      "tooltip": "RatPoison \u2014 Keyboard-Driven Mouse Control",
      "iconAsTemplate": true,
      "iconPath": "icons/tray-icon.png"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "linux": {
      "deb": {},
      "appimage": {}
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0RTk1NkQ2NzUzQkVBMkIKUldRcjZqdDExbGJwZEF6b3BuMVdLUEhHMUpnWUluTnVCUEhTa2pnOENGU0VBL3p4N2pVeUt0bWYK",
      "endpoints": [
        "https://github.com/emrisca/RatPoison/releases/latest/download/latest.json"
      ]
    }
  }
}
